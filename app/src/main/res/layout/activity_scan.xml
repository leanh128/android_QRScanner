<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:animateLayoutChanges="true"
    android:background="@android:color/black">

    <me.dm7.barcodescanner.core.CameraView
        android:id="@+id/scannerCamera"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/footer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:cornerRadius="8dp"
        app:squaredFinder="true"/>

    <FrameLayout
        android:id="@+id/footer"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:background="@android:color/black"
        app:layout_constraintBottom_toBottomOf="parent">

        <ImageView
            android:id="@+id/img_generate_qr"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_button_transparent"
            android:contentDescription="Generate QR Code"
            android:padding="8dp"
            android:src="@drawable/ic_new" />
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
